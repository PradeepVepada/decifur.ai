# Optional. Empty = use same-origin /api (Next.js app/api routes proxy to FastAPI — recommended for local dev).
# Example direct API: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# Server-side proxy target for app/api/* routes (defaults to NEXT_PUBLIC_API_URL or http://127.0.0.1:8000)
# API_PROXY_TARGET=http://127.0.0.1:8000
